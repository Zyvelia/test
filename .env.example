DISCORD_TOKEN=
# Optional: a SERVER ID where this bot is already installed with bot + applications.commands.
# Leave blank for global commands. Do not put an application ID or channel ID here.
DEV_GUILD_ID=

# Website and dashboard: enable for the local site; OAuth credentials enable dashboard login.
DASHBOARD_ENABLED=false
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DASHBOARD_REDIRECT_URI=http://127.0.0.1:8765/callback
# Selected artwork: neon-bob (option 3), neon-headset, silver-crown, velvet-moth.
WEBSITE_AVATAR=neon-bob
# Optional listener override for a future HTTPS reverse proxy; leave blank locally.
DASHBOARD_LISTEN_PORT=

# Optional OpenAI-compatible AI provider (for example a local Ollama server).
# /admin feature name:ai enabled:true AND ai_channels are required too.
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=

# Optional LibreTranslate-compatible /translate endpoint. Text is sent there only on request.
TRANSLATE_URL=
TRANSLATE_API_KEY=

# Music: install FFmpeg separately; leave blank to find ffmpeg on PATH.
FFMPEG_PATH=ffmpeg

# Optional Twitch stream notifications (application client credentials).
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Optional GitHub token for higher limits/private repositories. Scope it minimally.
# The token is used ONLY for explicitly bound server/repository pairs.
NOTIFY_GITHUB_TOKEN=
# Example: {"123456789012345678":["owner/repository"]}
NOTIFY_GITHUB_ACCESS={}

# Optional encrypted full-data backup key: file OUTSIDE the checkout (never paste key bytes).
BACKUP_KEY_FILE=

# Optional signed incoming webhook listener, separate from the local dashboard.
WEBHOOK_ENABLED=false
WEBHOOK_BIND_HOST=127.0.0.1
WEBHOOK_PORT=8766
# At least 32 random bytes/characters. Keep master private; export derived per-watch secrets.
WEBHOOK_SECRET=
# Your own HTTPS reverse-proxy origin, e.g. https://notify.example.com (no /hooks suffix).
WEBHOOK_PUBLIC_URL=

# Read-only Vivi release checker (no automatic downloads/install).
UPDATE_REPOSITORY=Zyvelia/test
# Optional dedicated token for private release metadata/rate limits.
UPDATE_GITHUB_TOKEN=

# Global-ban operator: a personal Discord user ID, never a bot token.
# Each server owner must separately opt in before enforcement.
GLOBAL_BAN_OPERATOR_ID=973054575076581456
